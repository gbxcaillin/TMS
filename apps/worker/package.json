{
  "name": "@tms/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean --noExternal @tms/db --noExternal @tms/shared --noExternal @tms/msgraph",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "@azure/msal-node": "^7.0.0",
    "@tms/db": "*",
    "@tms/msgraph": "*",
    "@tms/shared": "*",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.8.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
