{
  "name": "brightday-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:web": "npm run dev -w @tms/web",
    "dev:api": "npm run dev -w @tms/api",
    "dev:worker": "npm run dev -w @tms/worker",
    "build": "npm run build -w @tms/api -w @tms/worker -w @tms/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate -w @tms/db",
    "db:migrate": "npm run migrate -w @tms/db",
    "db:seed": "npm run seed -w @tms/db"
  },
  "engines": { "node": ">=22" }
}
