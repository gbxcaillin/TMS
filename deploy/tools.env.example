# Advice tools settings. Copy to deploy/tools.env (chmod 600). crm.env is a copy of crm/.env.production.example.

# The SAME value as DATA_KEYS in crm.env: run files and the tools database are sealed with it.
DATA_KEYS=v1:REPLACE_WITH_THE_CRM_KEY

# Claude API key for the Agent SDK (console.anthropic.com → API keys). Runs are billed to this key.
ANTHROPIC_API_KEY=

# Model and effort for advice runs. Opus is the default; lower effort costs less and runs faster.
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high
# Hard stop per run: turns and estimated spend in US dollars.
AGENT_MAX_TURNS=150
AGENT_MAX_BUDGET_USD=15
# 1 lets skills search and read the web (e.g. to check a product's current fees). Off by default.
AGENT_ALLOW_WEB=
# Runs that can go at once; the rest queue.
RUN_CONCURRENCY=2

# Who may approve SOA/ROA, annual review and OFA documents (CRM access-level roles, comma-separated).
APPROVER_ROLES=Admin,Manager,Client manager

# Upload limit per run, in MB (Caddy also caps requests at 100 MB).
MAX_UPLOAD_MB=100

# 1 runs a stand-in agent that writes a placeholder document: for a demo without an API key. Never in production.
AGENT_FAKE=
